# Server
NODE_ENV=development

# Vercel Postgres
# These are automatically provisioned when you link a Vercel Postgres store.
# Copy values from the Vercel dashboard → Storage → your Postgres database.
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=

# Authentication
# Generate a strong secret: openssl rand -base64 32
# Admin credentials live in the PostgreSQL admins table (password_hash).
JWT_SECRET=

# Razorpay (test keys from Dashboard → API Keys)
# Never commit real secrets. key_id is public; key_secret is server-only.
RAZORPAY_KEY_ID=rzp_test_TMSCqhTgWdhVQf
RAZORPAY_KEY_SECRET=RdlEFgwcOLyctY8nTpWYBwtJ

# CORS — comma-separated origins allowed to call this API
# e.g. https://telaqua.com,https://admin.telaqua.com,http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
