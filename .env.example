# Server
NODE_ENV=development
PORT=3000
# Hostinger / PaaS bind address (defaults to 0.0.0.0 in server.js)
HOST=0.0.0.0

# PostgreSQL (Neon) — use the same connection string previously in POSTGRES_URL
DATABASE_URL=

# Authentication
# Generate a strong secret: openssl rand -base64 32
JWT_SECRET=

# Customer WhatsApp OTP authentication (separate from admin JWT)
# Use at least 32 random characters; never expose it to the frontend.
# If omitted, a purpose-derived key from JWT_SECRET is used for compatibility.
CUSTOMER_AUTH_SECRET=
# Existing Interakt account API key, reused by invoice and OTP templates.
INTERAKT_API_KEY=
# Approved/synced Interakt Authentication template (copy-code/one-tap/zero-tap).
# Preferred names for the approved Interakt Authentication template.
INTERAKT_AUTH_TEMPLATE_NAME=
INTERAKT_AUTH_TEMPLATE_LANGUAGE=en
# Backward-compatible legacy names (optional; preferred names take precedence).
INTERAKT_OTP_TEMPLATE_NAME=
INTERAKT_OTP_LANGUAGE_CODE=en

# Razorpay (Dashboard → API Keys)
# Never commit real secrets. key_id is public; key_secret is server-only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard webhook signing secret (server-only; this is not the API key secret)
RAZORPAY_WEBHOOK_SECRET=

# Frontend origin(s) for CORS in production
# FRONTEND_URL=https://telaqua.com
# CORS_ORIGINS=https://telaqua.com,https://www.telaqua.com
FRONTEND_URL=
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Delhivery B2C (pincode serviceability)
# Never commit the real token.
# URL may be either:
#   https://staging-express.delhivery.com/c/api/pin-codes/json/
# or with placeholder:
#   https://staging-express.delhivery.com/c/api/pin-codes/json/?filter_codes=pin_code
# Backend always sets filter_codes to the request pincode.
DELHIVERY_API_TOKEN=
# Hostinger production must use: DELHIVERY_ENV=production
DELHIVERY_ENV=staging
DELHIVERY_STAGING_PINCODE_URL=https://staging-express.delhivery.com/c/api/pin-codes/json/?filter_codes=pin_code
DELHIVERY_PRODUCTION_PINCODE_URL=https://track.delhivery.com/c/api/pin-codes/json/?filter_codes=pin_code

# Delhivery Expected TAT
DELHIVERY_STAGING_TAT_URL=https://staging-express.delhivery.com/api/dc/expected_tat
DELHIVERY_PRODUCTION_TAT_URL=https://track.delhivery.com/api/dc/expected_tat

# Delhivery Waybill / AWB bulk fetch
DELHIVERY_STAGING_WAYBILL_URL=https://staging-express.delhivery.com/waybill/api/bulk/json/
DELHIVERY_PRODUCTION_WAYBILL_URL=https://track.delhivery.com/waybill/api/bulk/json/

# Delhivery Rate Calculator (base URL only — query params added by backend)
# Official path uses charges/.json (not charges/json/)
DELHIVERY_STAGING_RATE_URL=https://staging-express.delhivery.com/api/kinko/v1/invoice/charges/.json
DELHIVERY_PRODUCTION_RATE_URL=https://track.delhivery.com/api/kinko/v1/invoice/charges/.json

# Delhivery Client Warehouse Create
DELHIVERY_STAGING_WAREHOUSE_CREATE_URL=https://staging-express.delhivery.com/api/backend/clientwarehouse/create/
DELHIVERY_PRODUCTION_WAREHOUSE_CREATE_URL=https://track.delhivery.com/api/backend/clientwarehouse/create/

# Delhivery Client Warehouse Edit (optional; derived from CREATE URL if omitted)
DELHIVERY_STAGING_WAREHOUSE_EDIT_URL=https://staging-express.delhivery.com/api/backend/clientwarehouse/edit/
DELHIVERY_PRODUCTION_WAREHOUSE_EDIT_URL=https://track.delhivery.com/api/backend/clientwarehouse/edit/

# Delhivery Shipment / Package Creation (CMU)
DELHIVERY_STAGING_SHIPMENT_CREATE_URL=https://staging-express.delhivery.com/api/cmu/create.json
DELHIVERY_PRODUCTION_SHIPMENT_CREATE_URL=https://track.delhivery.com/api/cmu/create.json

# Delhivery Shipment / Package Edit (update)
DELHIVERY_STAGING_SHIPMENT_UPDATE_URL=https://staging-express.delhivery.com/api/p/edit
DELHIVERY_PRODUCTION_SHIPMENT_UPDATE_URL=https://track.delhivery.com/api/p/edit

# Delhivery Tracking (Pull API)
# Tracking implementation currently uses STAGING URL only (no production fallback).
DELHIVERY_STAGING_TRACKING_URL=https://staging-express.delhivery.com/api/v1/packages/json/
DELHIVERY_PRODUCTION_TRACKING_URL=https://track.delhivery.com/api/v1/packages/json/

# Delhivery Packing Slip / Shipping Label
# Label implementation currently uses STAGING URL only (no production fallback).
DELHIVERY_STAGING_LABEL_URL=https://staging-express.delhivery.com/api/p/packing_slip
DELHIVERY_PRODUCTION_LABEL_URL=https://track.delhivery.com/api/p/packing_slip

# Delhivery Pickup Request
# Pickup implementation currently uses STAGING URL only (no production fallback).
DELHIVERY_STAGING_PICKUP_URL=https://staging-express.delhivery.com/fm/request/new/
DELHIVERY_PRODUCTION_PICKUP_URL=https://track.delhivery.com/fm/request/new/

# Delhivery NDR Package Action Update
# NDR implementation currently uses STAGING URL only (no production fallback).
DELHIVERY_STAGING_NDR_URL=https://staging-express.delhivery.com/api/p/update
DELHIVERY_PRODUCTION_NDR_URL=https://track.delhivery.com/api/p/update

# Telaqua pickup warehouse (exact Delhivery warehouse name — case sensitive)
TELAQUA_WAREHOUSE_NAME=
# Street address shown on the registered Delhivery pickup location
TELAQUA_WAREHOUSE_ADDRESS=
TELAQUA_WAREHOUSE_CITY=
TELAQUA_WAREHOUSE_STATE=
TELAQUA_WAREHOUSE_PINCODE=
TELAQUA_WAREHOUSE_PHONE=

# Single-product package config (orders table has no product/weight columns)
TELAQUA_PRODUCT_NAME=Tel-Aqua Product
TELAQUA_BUSINESS_NAME=Tel-Aqua
# Chargeable weight in grams (required for shipment create)
TELAQUA_PRODUCT_WEIGHT_GM=
# Package dimensions in centimetres (required for shipment create; do not use 0)
TELAQUA_PRODUCT_LENGTH_CM=
TELAQUA_PRODUCT_WIDTH_CM=
TELAQUA_PRODUCT_HEIGHT_CM=

# Swipe invoice generation (server-only)
SWIPE_API_KEY=
SWIPE_BASE_URL=https://app.getswipe.in/api/partner/v2
SWIPE_PRODUCT_HSN=90314900
# Public backend base URL used to build invoice download links
BACKEND_BASE_URL=https://your-domain.com
# Optional: only needed if Swipe webhook is configured
SWIPE_WEBHOOK_SECRET=
