# Server
NODE_ENV=development

# Vercel Postgres
# These are automatically provisioned when you link a Vercel Postgres store.
# Copy values from the Vercel dashboard → Storage → your Postgres database.
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=

# Authentication
# Generate a strong secret: openssl rand -base64 32
JWT_SECRET=
ADMIN_USERNAME=
ADMIN_PASSWORD=

# CORS — comma-separated origins allowed to call this API
# e.g. https://telaqua.com,https://admin.telaqua.com,http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
